{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "media-literacy-cert-3h",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CERTIFICATION_STORE",
        "class_name": "CertificationStore"
      }
    ]
  },
  "exports": {
    "CertificationStore": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "vars": {
    "COURSE_TITLE": "媒體素養認證 3 小時",
    "REQUIRED_ACTIVE_SECONDS": "10800",
    "CERTIFICATE_ISSUER": "媒體素養認證 3 小時課程"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  }
}
